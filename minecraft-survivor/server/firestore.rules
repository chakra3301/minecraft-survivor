rules_version = '2';

// Security rules of Minecraft Survivor's online site (ported from PokéSurvivor's; see ../ONLINE.md).
//   saves/{uid}               the save: only its owner
//   names/{nick}              unique nicknames (lower case)
//   profiles/{uid}            each player's public profile
//   friendships/{a_b}         friend requests and friendships between two players
//   runs/{uid}                when your last run started (leaderboard anti-cheat)
//   lb/{board}/e/{id}         leaderboard entries: deepest floor, then time
//   lbs/{board}               a board's top 50 in one document
//   reports/{board__id__uid}  reports of suspicious entries (only the moderators read them)
//   pres/{uid}                approximate online status · inv/{to_from} co-op invites
// Everything else is closed.
//
// Generated blocks (between the marker comments): `node make-rules.mjs` writes the moderators
// (the online config's `admins`) and the achievements' rewards. Don't edit them by hand.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // <admins> (generated by make-rules.mjs from the online config's "admins")
    function admin() { return signedIn() && me() in ['7QitFEv2oVhEMhhFfZbPACicn5O2']; }
    // </admins>

    // ---------- the save ----------
    // The browser writes the save, so it can be edited. The server NEVER rejects a save for good
    // (nobody loses progress to a false positive): if it holds more than can be earned in the time
    // since the last save, it's only accepted with sus = true, and the account stays flagged (no
    // leaderboard). The game first tries without the flag, waits (the margin grows with time) and
    // only then sets it (js/core/db.js). Only a moderator can clear it.
    match /saves/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow read: if admin();

      allow create: if signedIn() && me() == uid && validSaveDoc()
        && (marked() || (saneSave(request.resource.data.save) && freshSave(request.resource.data.save)));
      allow update: if signedIn() && me() == uid && validSaveDoc()
        && (resource.data.get('sus', false) == false || marked())       // the flag can't be removed
        && (marked() || (saneSave(request.resource.data.save)
              && possibleSave(resource.data.save, request.resource.data.save,
                              (request.time - resource.data.updatedAt).seconds())));
      // A moderator can only set or clear the flag.
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sus'])
        && request.resource.data.sus is bool;
    }

    function marked() { return request.resource.data.get('sus', false) == true; }
    function validSaveDoc() {
      return request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v', 'sus'])
        && request.resource.data.save is map
        && request.resource.data.v is int
        && request.resource.data.get('sus', false) is bool
        && request.resource.data.updatedAt == request.time;
    }

    // What's impossible (with a wide margin, like a very good player playing non-stop).
    // Everything is counted in Spawner "pulls" (a Trial Key = 1, an Ominous Key = 10):
    //   Trial Keys     about 1 per 400 mobs defeated: < 1 every 30 s of play
    //   Ominous Keys   floor bosses (8 floors in ~20 min), Trial Chambers, the Aether (3):
    //                  < 1 every 2 min of play
    //   emeralds       a run pays < 15 per second with every upgrade (40 here); the Aether 1,000
    //   missions       3 a day + 2 a week · achievements: each with its reward (generated list below)
    // The collections of this game (js/core/db.js newSave):
    //   owned/shiny (mobs) · slayer (Ender Dragon beaten with a partner: enchanting unlocked)
    //   ascended (reached the Aether with a partner) · books (the Library) · ench (enchanted weapons)
    function tk(s, k) { return s.get('tickets', {}).get(k, 0); }
    function cnt(s, k) { return s.get(k, {}).size(); }
    function mis(s) { return s.get('stats', {}).get('missionsDone', 0); }
    function aeth(s) { return s.get('stats', {}).get('aether', 0); }
    function saneSave(s) {
      return s.get('coins', 0) is number && s.get('coins', 0) >= 0
        && tk(s, 't1') is number && tk(s, 't1') >= 0
        && tk(s, 't10') is number && tk(s, 't10') >= 0
        && mis(s) is number && aeth(s) is number && s.get('created', 0) is number
        && cnt(s, 'owned') <= 600 && cnt(s, 'shiny') <= 600
        && cnt(s, 'slayer') <= cnt(s, 'owned') && cnt(s, 'ascended') <= cnt(s, 'owned')
        && cnt(s, 'ench') <= cnt(s, 'owned') && cnt(s, 'books') <= 40;
    }
    // A new save: the starting one (deleting it and creating it again gains nothing).
    function freshSave(s) {
      return s.get('coins', 0) <= 2000 && tk(s, 't1') <= 10 && tk(s, 't10') <= 2
        && cnt(s, 'owned') <= 3 && cnt(s, 'shiny') <= 1 && cnt(s, 'ach') <= 5 && mis(s) <= 3
        && cnt(s, 'slayer') == 0 && cnt(s, 'ascended') == 0 && cnt(s, 'ench') == 0 && aeth(s) == 0
        && s.get('created', 0) > request.time.toMillis() - 2 * 86400000;
    }
    // What you had + what you could earn - what you have left = the pulls you could have made,
    // and they must cover the new mobs, Enchanted mobs and emeralds. (Firebase re-evaluates each
    // argument every time it's used and allows 1,000 operations: the costly part, the
    // achievements, appears only once.)
    function possibleSave(o, n, secs) {
      return n.get('created', 0) == o.get('created', 0)
        && n.get('ach', {}).keys().hasAll(o.get('ach', {}).keys())
        && n.get('slayer', {}).keys().hasAll(o.get('slayer', {}).keys())
        && n.get('ascended', {}).keys().hasAll(o.get('ascended', {}).keys())
        && cnt(n, 'ach') <= 160                                           // there are ~72 (js/data/achievements.js)
        && mis(n) >= mis(o)
        && mis(n) <= 10 + (request.time.toMillis() - o.get('created', 0)) / 86400000 * 5
        // The Aether (the end of an ~20-minute climb): at most one arrival per 15 minutes the account has existed.
        && aeth(n) >= aeth(o)
        && aeth(n) <= 1 + (request.time.toMillis() - o.get('created', 0)) / 900000
        && budget(o, n, secs > 7200 ? 7200 : (secs > 0 ? secs : 0),        // at most 2 h of play per save (saves come every 30 min)
                  secs >= 60 ? 1.0 : (secs > 0 ? secs / 60.0 : 0.0),        // saves close together: a smaller fixed margin
                  // missions claimed, and Aether arrivals (each pays 3 Ominous Keys + 1,000 emeralds ≈ 3 missions)
                  mis(n) - mis(o) + 3 * (aeth(n) - aeth(o)));
    }
    // e: seconds of play there could have been · k: fixed margin (0-1) · dm: missions claimed (+ 3 per Aether arrival)
    // (Rules re-evaluate an argument every time it's used, with a 1,000-expression cap: keep this small.)
    function budget(o, n, e, k, dm) {
      return tk(o, 't1') + 10 * tk(o, 't10')
        + 3 * k + e / 30 + cnt(n, 'ach') - cnt(o, 'ach') + 3 * dm     // Trial Keys that could be earned
        + 10 * (1 * k + e / 120 + dm)                                  // Ominous Keys
        + achV()                                                        // rewards of the new achievements
        - tk(n, 't1') - 10 * tk(n, 't10')
        >= mx(mx(0, cnt(n, 'owned') - cnt(o, 'owned') - 3 * k - e / 600),
              mx(cnt(n, 'shiny') - cnt(o, 'shiny') - 2 * k - e / 900,
                 // emeralds: from playing, achievements, missions and the Aether; the rest, Spawner refunds (< 300 a pull)
                 (n.get('coins', 0) - o.get('coins', 0) - 8000 * k - 40 * e - 1000 * dm) / 300));
    }
    function mx(a, b) { return a > b ? a : b; }
    // <achievements> (generated by make-rules.mjs, don't edit by hand)
    function achNew() { return request.resource.data.save.get('ach', {}).diff(resource.data.save.get('ach', {})).addedKeys(); }
    function achV() { let a = achNew(); return a.size() == 0 ? 0 : (1 * a.intersection(['own10', 'lvl20', 'kills1k', 'boss1', 'group1', 'leg_46', 'leg_59', 'leg_96', 'leg_121', 'leg_133'].toSet()).size()
        + 2 * a.intersection(['shiny1', 'evo1', 'items5', 'raid', 'dimOcean', 'dimUnder', 'rift1', 'ench1', 'mis10'].toSet()).size()
        + 3 * a.intersection(['time10'].toSet()).size()
        + 4 * a.intersection(['own50', 'phyg'].toSet()).size()
        + 10 * a.intersection(['own100', 'shiny5', 'pulls100', 'time15', 'lvl40', 'runs50', 'kills10k', 'boss25', 'evo25', 'itemsAll', 'monument', 'ominous', 'dimNether', 'dimStronghold', 'floors5', 'rift10', 'leg10', 'enchSlayer', 'anvil10', 'mis50', 'group10'].toSet()).size()
        + 20 * a.intersection(['own250', 'shiny20', 'time20', 'judge60', 'judgeBoss', 'boss100', 'dimEnd', 'dimAncient', 'judge', 'aether1', 'arenas', 'leg30', 'master1'].toSet()).size()
        + 30 * a.intersection(['own500', 'kills100k', 'evoAll', 'freeEnd', 'silence', 'aetherHalo', 'master5', 'mis200'].toSet()).size()
        + 40 * a.intersection(['judge300'].toSet()).size()
        + 50 * a.intersection(['aether7', 'legAll', 'masterStarters'].toSet()).size()
        + 100 * a.intersection(['ownAll', 'masterAll'].toSet()).size()
        + 0.333 * a.intersection(['own1'].toSet()).size()
        + 0.667 * a.intersection(['time5'].toSet()).size()); }
    // </achievements>

    // ---------- nicknames ----------

    match /names/{lower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && lower.size() >= 3 && lower.size() <= 16
        && lower == lower.lower();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Public profile: nickname, 3 favourites, title, best results and medals.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'best', 'medals'])
        && request.resource.data.name is string
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.at == request.time
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40))
        && (!('best' in request.resource.data) || request.resource.data.best is map)
        && (!('medals' in request.resource.data) || (request.resource.data.medals is list && request.resource.data.medals.size() <= 8))
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.lower)).data.uid == me();
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- friends ----------
    // One document per pair, id "smallerUid_largerUid".

    match /friendships/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.to in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      // Only the one who receives it can accept it.
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'names'])
        && request.resource.data.status == 'ok';
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // ---------- leaderboard ----------

    // When each run starts (in co-op, the host's) the server writes the time.
    match /runs/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['startedAt', 'mode'])
        && request.resource.data.startedAt == request.time;
    }

    // Floors: 0 Overworld, 1 Ocean, 2 Underworld, 3 Nether, 4 Stronghold, 5 The End,
    // 6 Ancient City, 7 Herobrine's World, 8 the Aether. The earliest a run can arrive on each
    // (seconds of run clock), from js/data/dimensions.js with ~10% slack: the Raid at 6:00, the
    // Elder Guardians (any time), the Ominous Breeze at 5:00, the Wither at 6:00, the End Portal
    // room (1:00 + 20 s), the Ender Dragon (0:20), four shrieks (~24 s), Herobrine's 2:30.
    function minFloorT(f) { return [0, 320, 320, 590, 920, 990, 1005, 1025, 1160][f]; }

    // An entry can only improve. Anti-cheat:
    //   - the score s folds floor and time: f * 100000 + (f == 8 ? 99999 - t : t)
    //     (floors 0-7: longer is better; the Aether: t = when you arrived, faster is better)
    //   - t can't be longer than the real time since your run started (runs/{uid}) + 30 s,
    //     nor 3 h; and the floor must be reachable in t (minFloorT)
    //   - level and kills with a wide margin (a very good team of 4)
    //   - the account can't be flagged (saves/{uid}.sus)
    function validEntry(board, id) {
      let d = request.resource.data;
      let run = get(/databases/$(database)/documents/runs/$(me())).data;
      return d.keys().hasOnly(['f', 's', 't', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'at'])
        && d.f is int && d.f >= 0 && d.f <= 8
        && d.t is int && d.t > 0 && d.t <= 10800
        && d.t >= minFloorT(d.f)
        && d.s is int && d.s == d.f * 100000 + (d.f == 8 ? 99999 - d.t : d.t)
        && d.t <= (request.time - run.startedAt).seconds() + 30
        && d.lv is int && d.lv >= 1 && d.lv <= 10 + d.t / 4
        && d.kills is int && d.kills >= 0 && d.kills <= 100 + d.t * 12
        && get(/databases/$(database)/documents/saves/$(me())).data.get('sus', false) == false
        && d.uids is list && me() in d.uids
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && d.at == request.time
        && (board.matches('s_.*')
              ? (d.uids.size() == 1 && id == me())
              : (d.uids.size() >= 2 && d.uids.size() <= 4 && id == d.uids.join('_')))
        && (resource == null || d.s > resource.data.s);
    }

    match /lb/{board}/e/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validEntry(board, id);
      allow delete: if signedIn() && (me() in resource.data.uids || admin());
    }

    // A board's top 50 (what the leaderboard screen reads).
    //   top: { id: { f, s, t, uids, names, dex, shiny, lv, kills } }
    //   me:  the row you add or improve (must match your validated entry, written in the same transaction)
    //   ev:  the row that drops out of the top (only if its score is below yours)
    // On account deletion: me = '' and ev = one of your rows, removed.
    function validTop(board) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data.top;
      let changed = d.top.diff(old).affectedKeys();
      return d.keys().hasOnly(['top', 'me', 'ev'])
        && d.top is map && d.top.size() <= 50
        && d.me is string && d.ev is string
        && (d.me == '' ? (removeMine(d, old, changed) || adminRemove(d, old)) : addMine(board, d, old, changed));
    }
    // Moderation: a moderator can only REMOVE rows.
    function adminRemove(d, old) {
      return admin() && old.keys().hasAll(d.top.keys()) && d.top.diff(old).changedKeys().size() == 0;
    }
    function addMine(board, d, old, changed) {
      let e = getAfter(/databases/$(database)/documents/lb/$(board)/e/$(d.me)).data;
      let row = d.top[d.me];
      return me() in e.uids
        && changed.hasOnly([d.me, d.ev])
        && row.f == e.f && row.s == e.s && row.t == e.t
        && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && (d.ev == '' || (!(d.ev in d.top) && d.ev in old && old[d.ev].s <= e.s));
    }
    function removeMine(d, old, changed) {
      return d.ev in old && me() in old[d.ev].uids && !(d.ev in d.top) && changed.hasOnly([d.ev]);
    }

    match /lbs/{board} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTop(board);
    }

    // Approximate presence: "online" if `at` is a few minutes old at most.
    match /pres/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['at', 'room', 'play', 'on'])
        && request.resource.data.at == request.time
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.play is bool && request.resource.data.on is bool;
      allow delete: if signedIn() && me() == uid;
    }

    // Invites to a co-op room: id "to_from". Only between confirmed friends.
    match /inv/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.to || me() == resource.data.from);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'room', 'name', 'at'])
        && request.resource.data.from == me()
        && id == request.resource.data.to + '_' + me()
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.to < me() ? request.resource.data.to + '_' + me() : me() + '_' + request.resource.data.to)).data.status == 'ok';
      allow delete: if signedIn() && (me() == resource.data.to || me() == resource.data.from);
    }

    // ---------- reports ----------
    // One report per player and entry (id "board__entry__yourUid"). The moderators read and
    // delete them in the hidden moderation screen.
    match /reports/{rid} {
      allow read, delete: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['board', 'e', 'names', 'f', 't', 'by', 'at'])
        && request.resource.data.by == me()
        && request.resource.data.board is string && request.resource.data.board.size() <= 40
        && request.resource.data.e is string && request.resource.data.e.size() <= 160
        && request.resource.data.names is list && request.resource.data.names.size() <= 4
        && request.resource.data.get('f', 0) is int
        && request.resource.data.t is int
        && request.resource.data.at == request.time
        && rid == request.resource.data.board + '__' + request.resource.data.e + '__' + me();
    }

    // To delete all your entries when you delete your account (collection-group query).
    match /{path=**}/e/{id} {
      allow read: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
